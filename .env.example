# Copy to `.env` (never commit `.env`). All backend settings are validated at startup
# by backend/app/core/config.py — the app refuses to start on invalid values.

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# Async SQLAlchemy URL. Plain postgres:// or postgresql:// URLs are normalised to asyncpg.
DATABASE_URL=postgresql+asyncpg://intervai:intervai@localhost:5432/intervai

# Comma-separated list of allowed browser origins. Production requires https origins, no "*".
CORS_ORIGINS=http://localhost:5173

# Draft playbooks are allowed locally; production refuses to start with this enabled.
ALLOW_DRAFT_PLAYBOOKS=true

# LLM provider. Without a key, plans are built from reviewed seeds only (no CV/JD AI analysis).
# Get a key at https://aistudio.google.com — never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional Gemini-compatible gateway (https). Empty = Google's endpoint.
GEMINI_BASE_URL=
LLM_TIMEOUT_SECONDS=45
# Character budget for playbook excerpts sent to the planner.
PLANNER_CONTEXT_CHARS=24000
# Max CV/JD upload size in bytes (5 MB).
MAX_UPLOAD_BYTES=5242880

# docker-compose PostgreSQL (only read by docker compose)
POSTGRES_USER=intervai
POSTGRES_PASSWORD=intervai
POSTGRES_DB=intervai
POSTGRES_PORT=5432
